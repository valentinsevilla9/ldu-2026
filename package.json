{
  "name": "ldu-next",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=20.9.0 <25"
  },
  "scripts": {
    "postinstall": "tsx scripts/db.ts generate",
    "predev": "tsx scripts/db.ts prepare",
    "dev": "next dev",
    "predev:offline": "tsx scripts/db.ts prepare && tsx scripts/seed.ts",
    "dev:offline": "cross-env NEXT_TELEMETRY_DISABLED=1 next dev",
    "prebuild": "tsx scripts/db.ts prepare",
    "build": "next build",
    "start": "next start",
    "preserve:lan": "npm run build",
    "serve:lan": "tsx scripts/serve-lan.ts",
    "test": "vitest run",
    "lint": "eslint . && prettier --check . --ignore-path .gitignore --ignore-path .prettierignore --ignore-path .prettierignore.local",
    "typecheck": "next typegen && tsc --noEmit",
    "format": "prettier --write . --ignore-path .gitignore --ignore-path .prettierignore --ignore-path .prettierignore.local",
    "seed": "tsx scripts/seed.ts",
    "db:migrate": "tsx scripts/db.ts migrate",
    "db:reset": "tsx scripts/db.ts reset",
    "db:studio": "prisma studio",
    "docs:pending": "tsx scripts/pending.ts",
    "prescreenshots": "tsx scripts/db.ts prepare",
    "screenshots": "tsx scripts/screenshots.ts",
    "deploy": "tsx scripts/deploy.ts"
  },
  "dependencies": {
    "@prisma/adapter-better-sqlite3": "7.10.0",
    "@prisma/adapter-pg": "7.10.0",
    "@prisma/client": "7.10.0",
    "class-variance-authority": "^0.7.1",
    "cn": "^0.4.0",
    "leaflet": "1.9.4",
    "lucide-react": "^1.52.0",
    "next": "16.3.8",
    "next-themes": "^0.4.6",
    "radix-ui": "^1.6.7",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-leaflet": "5.0.0",
    "shadcn": "^4.21.1",
    "sonner": "^2.0.8",
    "tw-animate-css": "^1.4.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@types/leaflet": "1.9.22",
    "@types/node": "^24.19.1",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitejs/plugin-react": "^6.1.1",
    "cross-env": "^10.1.0",
    "eslint": "^9",
    "eslint-config-next": "16.3.8",
    "eslint-config-prettier": "^10.1.8",
    "jsdom": "^29.1.1",
    "prettier": "^3.9.9",
    "prisma": "7.10.0",
    "puppeteer-core": "25.12.0",
    "tailwindcss": "^4",
    "tsx": "^4.23.15",
    "typescript": "^5",
    "vitest": "^5.0.3"
  },
  "allowScripts": {
    "better-sqlite3": true,
    "esbuild": true,
    "prisma": true,
    "@prisma/engines": true,
    "unrs-resolver": true
  }
}
