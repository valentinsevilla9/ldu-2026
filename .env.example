# Copia este archivo a .env y rellena los valores. Nunca subas .env al repositorio.
# Ninguna variable es obligatoria para arrancar con `npm run dev`: todas tienen
# un valor por defecto seguro.

# --- Base de datos ---
# SQLite por defecto (ruta relativa a la raíz del proyecto). Para Postgres o Supabase
# basta con cambiar esta URL y volver a lanzar `npm run dev`; no hay que tocar código:
# postgresql://usuario:contraseña@host:5432/base
DATABASE_URL="file:./prisma/dev.db"
# Con Postgres recién creado: carga las reglas de ejemplo si la base está vacía (despliegue).
SEED_IF_EMPTY=false

# --- Logs ---
# debug | info | warn | error | silent
LOG_LEVEL=info
